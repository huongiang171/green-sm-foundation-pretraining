    "start_inclusive": "2025-09-01T00:00:00",
    "train_end_exclusive": "2025-11-01T00:00:00",
    "validation_end_exclusive": "2025-11-16T00:00:00",
    "test_end_exclusive": "2025-12-01T00:00:00",
    "day_closing_at_boundary": "belongs to preceding split"
  },
  "compression": {
